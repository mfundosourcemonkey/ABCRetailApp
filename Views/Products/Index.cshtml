@model List<ABCRetailApp.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a class="btn btn-primary" asp-action="Create">Add Product</a>
</div>
<p class="text-muted">Product details are stored in Azure Table Storage; product images are stored in Azure Blob Storage.</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:200px;object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text"><strong>R@product.Price.ToString("0.00")</strong> &middot; @product.StockQuantity in stock</p>
                </div>
                <div class="card-footer">
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this product?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partitionKey" value="@product.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@product.RowKey" />
                        <input type="hidden" name="imageFileName" value="@product.ImageFileName" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
