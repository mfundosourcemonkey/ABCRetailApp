@{
    ViewData["Title"] = "ABC Retail Cloud";
}

<div class="abc-hero text-center">
    <h1 class="display-5">ABC Retail Cloud</h1>
    <p class="lead mx-auto">Cloud order processing for ABC Retail, built on Azure Storage: Tables, Blobs, Queues, and Files.</p>
</div>

<div class="row row-cols-1 row-cols-md-4 g-4">
    <div class="col">
        <div class="card h-100 abc-feature-card">
            <div class="card-body">
                <div class="abc-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M5 20c0-3.31 3.13-6 7-6s7 2.69 7 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </div>
                <h5 class="card-title">Customers</h5>
                <p class="card-text">Customer profiles stored in Azure Table Storage.</p>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-primary">View Customers</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 abc-feature-card">
            <div class="card-body">
                <div class="abc-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M3.5 7.5L12 3L20.5 7.5V16.5L12 21L3.5 16.5V7.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M3.5 7.5L12 12M12 12L20.5 7.5M12 12V21" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h5 class="card-title">Products</h5>
                <p class="card-text">Product catalog and images stored in Table &amp; Blob Storage.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">View Products</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 abc-feature-card">
            <div class="card-body">
                <div class="abc-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="4" y="5" width="16" height="15" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M8 3.5V6.5M16 3.5V6.5M4 9.5H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <path d="M8 13.5L11 16.5L16 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h5 class="card-title">Orders</h5>
                <p class="card-text">Order and inventory transactions stored in Azure Queue Storage.</p>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary">View Orders</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 abc-feature-card">
            <div class="card-body">
                <div class="abc-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M7 3.5H14L18 7.5V20.5H7V3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M14 3.5V7.5H18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M9.5 12H15.5M9.5 15.5H15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </div>
                <h5 class="card-title">Logs</h5>
                <p class="card-text">Application log files stored in Azure File Storage.</p>
                <a asp-controller="Logs" asp-action="Index" class="btn btn-outline-primary">View Logs</a>
            </div>
        </div>
    </div>
</div>
