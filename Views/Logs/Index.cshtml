@model List<string>
@{
    ViewData["Title"] = "Log Files";
}

<div class="d-flex justify-content-between align-items-center mb-3 abc-page-header">
    <div>
        <h1>Log Files</h1>
        <p class="text-muted mb-0">Log files are stored in Azure File Storage. Customer, product, and order actions automatically write a log entry here.</p>
    </div>
    <a class="btn btn-primary" asp-action="Upload">Upload File</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

<div class="table-responsive-card">
<table class="table table-striped">
    <thead>
        <tr>
            <th>File Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fileName in Model)
        {
            <tr>
                <td>@fileName</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Download" asp-route-fileName="@fileName">Download</a></td>
            </tr>
        }
    </tbody>
</table>
</div>
