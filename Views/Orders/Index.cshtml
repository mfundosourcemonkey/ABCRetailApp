@model List<ABCRetailApp.Models.OrderQueueMessage>
@{
    ViewData["Title"] = "Orders & Inventory Queue";
}

<div class="d-flex justify-content-between align-items-center mb-3 abc-page-header">
    <div>
        <h1>Orders &amp; Inventory Queue</h1>
        <p class="text-muted mb-0">Order processing and inventory transactions are stored in Azure Queue Storage.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Message</a>
</div>

<form asp-action="ProcessNext" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary">Process Next Message</button>
</form>

<div class="table-responsive-card">
<table class="table table-striped">
    <thead>
        <tr>
            <th>Type</th>
            <th>Item</th>
            <th>Action</th>
            <th>Quantity</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model)
        {
            <tr>
                <td>@message.MessageType</td>
                <td>@message.ItemName</td>
                <td>@message.Action</td>
                <td>@message.Quantity</td>
                <td>@message.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
</div>
