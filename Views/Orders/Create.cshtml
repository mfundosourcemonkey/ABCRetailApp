@model ABCRetailApp.Models.OrderQueueMessage
@{
    ViewData["Title"] = "New Order / Inventory Message";
}

<h1>New Order / Inventory Message</h1>

<form asp-action="Create" method="post" class="col-md-6 form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="MessageType" class="form-label"></label>
        <select asp-for="MessageType" class="form-select" asp-items="Html.GetEnumSelectList<ABCRetailApp.Models.QueueMessageType>()"></select>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ItemName" class="form-label"></label>
        <input asp-for="ItemName" class="form-control" placeholder="e.g. Product name" />
        <span asp-validation-for="ItemName" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send to Queue</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
