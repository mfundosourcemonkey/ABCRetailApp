@model List<ABCRetailApp.Models.CustomerProfile>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3 abc-page-header">
    <div>
        <h1>Customers</h1>
        <p class="text-muted mb-0">Customer profiles are stored in Azure Table Storage.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Customer</a>
</div>

<div class="table-responsive-card">
<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Shipping Address</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FullName</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.ShippingAddress</td>
                <td>@customer.Timestamp?.ToLocalTime().ToString("g")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partitionKey" value="@customer.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@customer.RowKey" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
