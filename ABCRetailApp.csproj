<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABCRetailApp.Shared and ABCRetailApp.Functions are sibling projects nested under this
         folder (to keep everything in one git repo); exclude their files from this project's
         default globs so they aren't compiled twice (once here, once via ProjectReference). -->
    <Compile Remove="ABCRetailApp.Shared\**" />
    <Compile Remove="ABCRetailApp.Functions\**" />
    <Content Remove="ABCRetailApp.Shared\**" />
    <Content Remove="ABCRetailApp.Functions\**" />
    <None Remove="ABCRetailApp.Shared\**" />
    <None Remove="ABCRetailApp.Functions\**" />
    <EmbeddedResource Remove="ABCRetailApp.Shared\**" />
    <EmbeddedResource Remove="ABCRetailApp.Functions\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ABCRetailApp.Shared\ABCRetailApp.Shared.csproj" />
  </ItemGroup>

</Project>
